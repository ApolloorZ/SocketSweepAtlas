# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SocketSweep custom ignores
engine/daemon
output.json

# Vendored Windows platform-tools drops, copied in by hand for local builds
src-tauri/bin/adb.exe
src-tauri/bin/AdbWinApi.dll
src-tauri/bin/AdbWinUsbApi.dll

# Only the GNU toolchain links this dynamically — MSVC gets WebView2LoaderStatic
# from webview2-com-sys, which is why CI's Windows build does not need this file.
src-tauri/webview2/WebView2Loader.dll

# Exclude local JSON test dumps
out*.json

# The daemon tests are Python; running them leaves bytecode next to the sources.
__pycache__/
*.py[cod]

